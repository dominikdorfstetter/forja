# Base URLs
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:8000

# Test database (separate from dev — uses different ports)
E2E_DATABASE_URL=postgres://forja:forja@localhost:5433/forja_test
E2E_REDIS_URL=redis://127.0.0.1:6380

# Clerk development instance keys (must match backend config)
E2E_CLERK_PUBLISHABLE_KEY=pk_test_...
E2E_CLERK_SECRET_KEY=sk_test_...

# Clerk test accounts — one per role
E2E_VIEWER_EMAIL=viewer@test.forja.dev
E2E_VIEWER_PASSWORD=changeme
E2E_REVIEWER_EMAIL=reviewer@test.forja.dev
E2E_REVIEWER_PASSWORD=changeme
E2E_AUTHOR_EMAIL=author@test.forja.dev
E2E_AUTHOR_PASSWORD=changeme
E2E_EDITOR_EMAIL=editor@test.forja.dev
E2E_EDITOR_PASSWORD=changeme
E2E_ADMIN_EMAIL=admin@test.forja.dev
E2E_ADMIN_PASSWORD=changeme
E2E_OWNER_EMAIL=owner@test.forja.dev
E2E_OWNER_PASSWORD=changeme
E2E_SYSTEM_ADMIN_EMAIL=sysadmin@test.forja.dev
E2E_SYSTEM_ADMIN_PASSWORD=changeme

# Playwright settings
E2E_HEADLESS=true
E2E_SLOW_MO=0
E2E_TIMEOUT=30000
