# Application Configuration
APP__ENVIRONMENT=development
APP__HOST=0.0.0.0
APP__PORT=8000
APP__LOG_LEVEL=debug
APP__ENABLE_TRACING=true
# Public URL of this instance (used for media URLs and the imprint endpoint)
# PUBLIC_URL=http://localhost:8000

# Logging
# LOG_FORMAT=json                    # force JSON logs (auto-enabled when RAILWAY_ENVIRONMENT is set)
# RUST_LOG=forja=info,axum=warn,sqlx=warn   # tracing filter (default shown)

# Database Configuration
DATABASE_URL=postgres://forja:forja@localhost:5432/forja
APP__DATABASE__MAX_CONNECTIONS=20
APP__DATABASE__MIN_CONNECTIONS=2
APP__DATABASE__CONNECT_TIMEOUT_SECONDS=5
APP__DATABASE__IDLE_TIMEOUT_SECONDS=600

# CORS — comma-separated list of allowed origins. Empty = deny all
# cross-origin browser calls. Wildcard ("*") is refused at startup in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Redis & Rate Limiting
REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_FAIL_MODE=closed       # "closed" (default — reject if Redis is down) or "open" (allow)
# RATE_LIMIT_BURST_PER_SECOND=100    # per-API-key burst cap (raise for SSR fan-out)
# TRUST_PROXY_HEADERS=false          # set true when running behind nginx/Caddy/HAProxy

# Clerk Authentication
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# SYSTEM_ADMIN_CLERK_IDS=user_...
# Optional: override auto-detected Clerk FAPI domain for CSP headers
# CLERK_FAPI_DOMAIN=your-instance.clerk.accounts.dev
# Pin JWT aud/iss claims so cross-environment or cross-app tokens are rejected.
# Both are required in production when CLERK_SECRET_KEY is set; non-production
# emits warnings only.
# CLERK_EXPECTED_AUDIENCE=forja-prod
# CLERK_EXPECTED_ISSUER=https://clerk.your-app.com   # required in production
# Optional: explicit JWKS URL (normally derived from the Clerk instance)
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Encryption (AES-256-GCM for AI API keys)
# In development, a built-in dev key is used automatically when unset.
# In production, generate with: openssl rand -base64 32
# The legacy alias AI_ENCRYPTION_KEY is also accepted.
# ENCRYPTION_KEY=

# Document Encryption (enables admin recovery for password-protected documents)
# Generate with: openssl rand -base64 32
# DOCUMENT_ENCRYPTION_KEY=
# DOCUMENT_ENCRYPTION_KEY_OLD=       # set during key rotation

# Storage (defaults to local filesystem — uncomment for S3)
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_UPLOAD_DIR=./uploads
# STORAGE_LOCAL_BASE_URL=/uploads
# STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=my-bucket
# STORAGE_S3_REGION=eu-central-1
# STORAGE_S3_PREFIX=media/
# STORAGE_S3_ENDPOINT=http://localhost:9000

# TLS / HTTPS (production only — leave unset for HTTP in development)
# TLS_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# Demo mode — auto-seeds demo site and auto-joins new users (default: false)
# DEMO_MODE=true

# Imprint / Impressum — deployment-operator legal details, served at runtime by
# GET /api/v1/imprint (public). The required trio (NAME + ADDRESS + EMAIL) must
# all be set for the Welcome footer to show the Imprint link; otherwise the
# endpoint returns {configured:false} and the link stays hidden. Never commit
# real operator details — set these per deployment only.
# IMPRINT_OPERATOR_NAME=Acme GmbH
# IMPRINT_ADDRESS=Hauptstraße 1, 1010 Wien, Austria
# IMPRINT_EMAIL=legal@acme.example
# IMPRINT_PHONE=+43 1 2345678
# IMPRINT_VAT=ATU12345678
# IMPRINT_REGISTER=FN 123456a, Handelsgericht Wien
# IMPRINT_RESPONSIBLE=Jane Doe

# Preview
# HMAC secret for signed preview tokens — leave empty to disable preview links
# APP__SECURITY__PREVIEW_TOKEN_SECRET=
# Built-in preview templates, "Name|url" pairs separated by commas
# APP__PREVIEW__BUILT_IN_TEMPLATES=Blog|http://localhost:4321

# Caching & Background Workers (defaults shown)
# RESPONSE_CACHE_TTL_SECS=60         # public response cache TTL
# PERMISSION_CACHE_TTL_SECS=300      # permission lookup cache TTL
# WEBHOOK_DEAD_RETENTION_DAYS=30     # keep dead webhook deliveries this long

# Audit
# APP__AUDIT__RETENTION_DAYS=365     # audit log retention (default: 365)

# Advanced security tuning (defaults shown — override only when needed)
# Request size limits
# APP__SECURITY__MAX_BODY_SIZE=10485760      # 10 MB
# APP__SECURITY__MAX_JSON_SIZE=15728640      # 15 MB
# APP__SECURITY__MAX_FORM_SIZE=10485760      # 10 MB
# APP__SECURITY__MAX_FILE_SIZE=52428800      # 50 MB
# Per-IP rate limits
# APP__SECURITY__RATE_LIMIT_PER_SECOND=50
# APP__SECURITY__RATE_LIMIT_PER_MINUTE=500
# APP__SECURITY__RATE_LIMIT_BURST=20
# Payload structure limits
# APP__SECURITY__MAX_JSON_DEPTH=10
# APP__SECURITY__MAX_ARRAY_ITEMS=1000
# APP__SECURITY__REQUEST_TIMEOUT_SECONDS=30
# Anomaly detection
# APP__SECURITY__ANOMALY_DETECTION_ENABLED=true
# APP__SECURITY__ANOMALY_HOURLY_MULTIPLIER=5.0
# APP__SECURITY__ANOMALY_DAILY_MULTIPLIER=3.0
# APP__SECURITY__ANOMALY_ERROR_RATE_THRESHOLD=0.5
# APP__SECURITY__ANOMALY_MIN_REQUESTS=20
# Volume spikes are alert-only by default (quota already caps volume);
# set to true to restore hard-blocking on hourly/daily spikes
# APP__SECURITY__ANOMALY_BLOCK_ON_VOLUME_SPIKE=false
# Floors for the relative spike thresholds: effective = max(avg × multiplier, floor)
# APP__SECURITY__ANOMALY_MIN_HOURLY_THRESHOLD=1000
# APP__SECURITY__ANOMALY_MIN_DAILY_THRESHOLD=10000
# Auth failure rate limiting / banning
# APP__SECURITY__AUTH_RATE_LIMIT_MAX_FAILURES=5
# APP__SECURITY__AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# APP__SECURITY__AUTH_RATE_LIMIT_BAN_MAX_FAILURES=20
# APP__SECURITY__AUTH_RATE_LIMIT_BAN_WINDOW_SECONDS=3600
