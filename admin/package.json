    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "stylis-plugin-rtl": "^2.1.1",
    "tippy.js": "^6.3.7",
    "tiptap-markdown": "^0.9.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
