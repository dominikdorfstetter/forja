{
  "name": "forja-admin",
  "version": "2.1.4",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "NODE_OPTIONS=--max-old-space-size=4096 vitest",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "react-doctor": "react-doctor . --offline -y",
    "react-doctor:verbose": "react-doctor . --offline -y --verbose",
    "react-doctor:online": "react-doctor . -y --fail-on warning --score",
    "generate:openapi": "cargo run --manifest-path ../backend/Cargo.toml --bin dump_openapi --quiet > openapi.json && openapi-typescript openapi.json -o src/generated/api-types.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.10",
