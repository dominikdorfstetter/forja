{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TS 7 removed `baseUrl`, but @docusaurus/tsconfig still sets it — null
    // resets the inherited value. `paths` resolves relative to this file now,
    // so `@site/*` is re-anchored to the docs dir explicitly.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  }
}
