{
  "name": "@forjacms/analytics",
  "version": "2.1.4",
  "description": "Privacy-first analytics tracker for Forja CMS. No cookies, no PII.",
  "author": "Dominik Dorfstetter <dominik@dorfstetter.at>",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --minify",
    "dev": "tsdown src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "analytics",
    "privacy",
    "gdpr",
    "forja",
    "cms"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominikdorfstetter/forja.git",
    "directory": "libs/analytics"
  },
  "homepage": "https://github.com/dominikdorfstetter/forja/tree/main/libs/analytics#readme",
  "bugs": "https://github.com/dominikdorfstetter/forja/issues",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "typescript": "^6.0.3"
  }
}
