---
import Base from "../../../layouts/Base.astro";
import ResponsiveImage from "../../../components/ResponsiveImage.astro";
import SeoHead from "../../../components/SeoHead.astro";
import { renderMarkdown } from "../../../lib/markdown";
import { buildSeoMeta } from "../../../lib/seo";
import { validatePreviewToken } from "../../../lib/preview-token";
import {
  fetchPreviewBlogBySlug,
  fetchPreviewMedia,
  fetchPreviewSite,
  fetchPreviewFavicon,
} from "../../../lib/preview-api";
import type { MediaResponse } from "../../../lib/api";

// --- Token validation ---
const token = Astro.url.searchParams.get("token");
if (!token) {
  return new Response("Missing preview token", { status: 401 });
}

const siteId = validatePreviewToken(token);
if (!siteId) {
  return new Response("Invalid or expired preview token", { status: 403 });
}

const ctx = { siteId, token };

// --- Fetch content ---
const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/blog");
}

let blog;
try {
  blog = await fetchPreviewBlogBySlug(slug, ctx);
} catch (e) {
  console.warn("[Preview] Failed to fetch blog:", e instanceof Error ? e.message : e);
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const loc = blog.localizations[0];
const title = loc?.title ?? "Untitled";
const body = renderMarkdown(loc?.body);
const metaTitle = loc?.meta_title ?? title;
const metaDescription = loc?.meta_description ?? loc?.excerpt ?? "";

// --- Fetch site metadata ---
const [site, favicon] = await Promise.all([
  fetchPreviewSite(ctx).catch(() => null),
  fetchPreviewFavicon(ctx),
]);
const siteName = site?.name ?? "Preview";

let coverMedia: MediaResponse | null = null;
if (blog.cover_image_id) {
  try {
    coverMedia = await fetchPreviewMedia(blog.cover_image_id, ctx);
  } catch {
    // Cover image is optional for preview
  }
}

const date = blog.published_date
  ? new Date(blog.published_date).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "Unpublished";

const seo = buildSeoMeta({
  title: `[Preview] ${metaTitle}`,
  description: metaDescription,
  canonicalUrl: "",
  siteUrl: Astro.url.origin,
  siteName,
  ogType: "article",
  ogImage: coverMedia?.public_url ?? undefined,
  ogImageAlt: title,
});

// Prevent indexing and caching of preview pages
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Cache-Control", "no-store");
---

<Base title={`[Preview] ${title}`} metaTitle={metaTitle} metaDescription={metaDescription}>
  <SeoHead seo={seo} slot="head" />
  {favicon?.favicon_url && (
    <link rel="icon" href={favicon.favicon_url} slot="head" />
  )}
  {favicon?.apple_touch_icon_url && (
    <link rel="apple-touch-icon" href={favicon.apple_touch_icon_url} slot="head" />
  )}

  {/* Preview banner */}
  <div style="position:fixed;top:0;left:0;right:0;z-index:9999;background:linear-gradient(135deg,#f59e0b,#d97706);color:#000;text-align:center;padding:8px 16px;font-size:13px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);">
    Preview Mode — {blog.status} · {siteName}
    <span style="font-weight:normal;opacity:0.7;margin-left:8px;">Token expires in 5 min</span>
  </div>

  <article class="max-w-prose mx-auto" style="margin-top:48px;">
    {/* Status badge */}
    <div class="flex items-center gap-2 mb-4">
      <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200">
        {blog.status}
      </span>
    </div>

    {/* Category pills */}
    {blog.categories.length > 0 && (
      <div class="flex gap-1.5 mb-4 flex-wrap">
        {blog.categories.map((cat, i) => (
          <span
            class={`text-[11px] font-medium px-2.5 py-0.5 rounded-full ${
              i === 0
                ? "bg-gradient-to-r from-violet-600 to-violet-400 text-white"
                : "bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400"
            }`}
          >
            {cat.slug}
          </span>
        ))}
      </div>
    )}

    {/* Title */}
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mb-4">
      {title}
    </h1>

    {/* Meta row */}
    <div class="flex items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400 pb-6 border-b border-zinc-200 dark:border-zinc-800">
      {blog.author && <span>{blog.author}</span>}
      <span class="text-zinc-300 dark:text-zinc-700">&middot;</span>
      <span>{date}</span>
      {blog.reading_time_minutes && (
        <>
          <span class="text-zinc-300 dark:text-zinc-700">&middot;</span>
          <span>{blog.reading_time_minutes} min read</span>
        </>
      )}
    </div>

    {/* Cover image */}
    {coverMedia && (
      <div class="my-6">
        <ResponsiveImage
          media={coverMedia}
          alt={title}
          class="w-full rounded-xl"
          sizes="(max-width: 768px) 100vw, 740px"
          loading="eager"
        />
      </div>
    )}

    {/* Article body */}
    <div class="prose" set:html={body} />
  </article>
</Base>
